# Supabase (public values are safe for the browser; they are protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# AI (server only)
LLM_API_KEY=
LLM_MODEL=
# Voice uses this same Gemini API key; no additional credential is required.
VOICE_STT_MODEL=gemini-3.5-transcribe
VOICE_TTS_MODEL=gemini-3.8-flash-tts
CREDITS_ENABLED=false
IMAGE_API_KEY=            # optional; without it scenes use gradients, not AI images

# Rate limiting (optional, Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron protection for /api/cron/*
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
